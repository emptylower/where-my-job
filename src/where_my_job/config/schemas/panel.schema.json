{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "columns"],
  "properties": {
    "schema_version": {"const": 1},
    "title": {"type": "string", "maxLength": 120},
    "columns": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "string"}},
    "sort": {"type": "object", "additionalProperties": false, "required": ["by"],
             "properties": {"by": {"type": "string"}, "desc": {"type": "boolean"}}},
    "filters": {"type": "array", "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["column", "op", "value"],
                "properties": {"column": {"type": "string"}, "op": {"type": "string", "enum": ["=", "!=", ">=", "<=", ">", "<", "~"]},
                               "value": {"type": ["string", "number"]}}}},
    "charts": {"type": "array", "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["type", "by"],
               "properties": {"type": {"type": "string", "enum": ["bar"]}, "by": {"type": "string", "enum": ["dir", "tier", "city", "exp", "degree", "report_state", "application_state"]}}}},
    "page_size": {"type": "integer", "minimum": 1, "maximum": 500},
    "show_unknown_in_main": {"type": "boolean"},
    "timeline": {"type": "object", "additionalProperties": false,
                 "properties": {"enabled": {"type": "boolean"},
                                "streams": {"type": "array", "maxItems": 10,
                                            "items": {"type": "string", "pattern": "^(applications|custom\\.[a-z][a-z0-9_]{0,62})$"}}}}
  }
}
