{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "name", "searches", "budget"],
  "$defs": {
    "filterValue": {"oneOf": [
      {"type": "string", "minLength": 1},
      {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    ]}
  },
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "searches": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
                 "required": ["keywords", "cities"],
                 "properties": {"keywords": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                                "cities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                                "pages": {"type": "integer", "minimum": 1, "maximum": 80, "default": 1},
                                "boss_filters": {"type": "object", "additionalProperties": false,
                                                 "properties": {"experience": {"$ref": "#/$defs/filterValue"}, "degree": {"$ref": "#/$defs/filterValue"},
                                                                "salary": {"$ref": "#/$defs/filterValue"}, "scale": {"$ref": "#/$defs/filterValue"},
                                                                "stage": {"$ref": "#/$defs/filterValue"}, "industry": {"$ref": "#/$defs/filterValue"}}}}}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["pause_between_actions_sec"],
               "properties": {"max_pages_per_run": {"type": "integer", "minimum": 1, "maximum": 80, "default": 20},
                              "pause_between_actions_sec": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}}}
  }
}
