{
  "schema_version": 1,
  "stream": "custom.interviews",
  "stream_revision": 1,
  "subject_kind": "application",
  "types": {
    "scheduled": {
      "required": [
        "round",
        "at"
      ],
      "fields": {
        "round": "string",
        "at": "datetime",
        "format": {
          "enum": [
            "onsite",
            "video",
            "phone"
          ]
        }
      }
    },
    "done": {
      "required": [
        "round"
      ],
      "fields": {
        "round": "string",
        "questions": "string",
        "self_rating": "integer"
      }
    }
  }
}
